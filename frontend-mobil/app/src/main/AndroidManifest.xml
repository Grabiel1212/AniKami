<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frontendankami"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".presentation.activitys.manga.visor.ReaderActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.manga.MangaActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.favorites.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.search.SearchActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.categories.CategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.recovery.RecoveryActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activitys.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>