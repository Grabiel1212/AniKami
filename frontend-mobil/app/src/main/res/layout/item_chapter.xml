<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Imagen del capítulo (rectangular, sin círculo) -->
        <ImageView
            android:id="@+id/img_chapter_cover"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/banner1"
            android:contentDescription="Portada del capítulo"/>

        <!-- Contenedor de texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Título del capítulo -->
            <TextView
                android:id="@+id/txt_chapter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capítulo X"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>



        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
